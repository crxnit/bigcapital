# Staging (UAT) .env reference — host staging.bc.jjocllc.com.
# Lives on the VPS at /srv/portal/clients/staging-bc/.env (gitignored).
# This file documents the Square (production) block that the deploy compose
# (docker-compose.uat-ghcr.yml → docker-compose.ghcr.yml on the VPS) expects;
# the rest of the env (DB creds, JWT_SECRET, S3/MinIO, Plaid, Stripe, MAIL_*,
# THROTTLE_*, etc.) is the live staging config and is not reproduced here.
#
# Var names verified against packages/server/src/modules/SquareIntegration
# (read via this.config.get<string>('…')). After editing, recreate the server:
#   docker compose -f docker-compose.ghcr.yml up -d --force-recreate server

# ──────────────────────────────────────────────────────────────────────────
# Public URLs (should already be set)
# ──────────────────────────────────────────────────────────────────────────
BASE_URL=https://staging.bc.jjocllc.com
WEBAPP_BASE_URL=https://staging.bc.jjocllc.com

# ──────────────────────────────────────────────────────────────────────────
# Square — PRODUCTION app dedicated to the staging host
# ──────────────────────────────────────────────────────────────────────────
# Square allows only ONE redirect URI per OAuth app, so this must be its own
# app, distinct from the sandbox.bc app. Register the callback below under the
# Production app's OAuth → Redirect URL.
#
# Credentials: Developer Dashboard → app → Credentials (Production):
#   Application ID, Application Secret (OAuth), Access Token (PAT).
# The PAT is required to register the app-level webhook subscription via
# /v2/webhooks/subscriptions and to verify inbound webhook HMAC signatures.
SQUARE_ENVIRONMENT=production
SQUARE_OAUTH_REDIRECT_URL=https://staging.bc.jjocllc.com/api/integrations/square/oauth/callback
SQUARE_APPLICATION_ID=<production-application-id>
SQUARE_APPLICATION_SECRET=<production-application-secret>
SQUARE_APPLICATION_ACCESS_TOKEN=<production-access-token-PAT>

# AES-256-GCM key for token-at-rest encryption. MUST be 64 hex chars (32 bytes)
# and MUST stay stable once any Square tokens are stored (rotating it orphans
# every encrypted token). Distinct from the sandbox key. Generate with:
#   openssl rand -hex 32
SQUARE_TOKEN_ENCRYPTION_KEY=<64 hex chars, distinct from sandbox>

# ──────────────────────────────────────────────────────────────────────────
# NOTE: inbound webhooks also need a Traefik router for
# /api/integrations/square/webhooks at priority ≥ 20 WITHOUT the OAuth
# forward-auth middleware (HMAC is the auth). OAuth + posting work without it;
# only webhook delivery depends on it. See docs/SQUARE-INTEGRATION.md.
# ──────────────────────────────────────────────────────────────────────────
