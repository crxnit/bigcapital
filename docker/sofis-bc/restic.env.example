# Restic backend + repo creds for the Sofi's backup script.
# Install at /etc/restic/bigcapital-sofis.env  (chmod 0600 root:root — secrets).
# Sourced by /srv/portal/clients/sofis-bc/backup.sh. Keep it OFF this VPS's own storage
# conceptually: the *repository* must be offsite (another provider/region) so a
# full VPS loss doesn't take the backups with it.
#
# Generate a strong, UNIQUE repo password (store it in your password manager —
# if you lose it the backups are unrecoverable):
#   openssl rand -base64 32

# ── Repository (pick ONE backend) ───────────────────────────────────────────
# S3 / S3-compatible (AWS, Backblaze B2 S3, Wasabi, Cloudflare R2, etc.):
export RESTIC_REPOSITORY="s3:https://s3.<region>.amazonaws.com/<your-backup-bucket>/sofis"
export AWS_ACCESS_KEY_ID="<backup-bucket-access-key>"
export AWS_SECRET_ACCESS_KEY="<backup-bucket-secret-key>"

# …or Backblaze B2 native:
# export RESTIC_REPOSITORY="b2:<bucket>:sofis"
# export B2_ACCOUNT_ID="<keyId>"
# export B2_ACCOUNT_KEY="<applicationKey>"

# ── Repo password (REQUIRED) ────────────────────────────────────────────────
export RESTIC_PASSWORD="<long-random-restic-password>"
