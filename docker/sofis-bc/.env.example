# ============================================================================
# Sofi's Mini Donuts — dedicated production instance .env
# Copy to `.env` and fill every <...> placeholder.
#
# This is a STANDALONE instance (not a clone), so every secret below is fresh
# and independent — nothing needs to match staging.
#
# IMPORTANT: Docker's env_file does NOT strip inline `#` comments — the whole
# right-hand side becomes the value. Keep every comment on its OWN line.
# ============================================================================

# ── Pinned images (manual updates only — NOT wired to develop) ──────────────
# Set both to the vetted SHA tag currently proven on staging. Update by editing
# these two lines + `docker compose up -d --force-recreate server webapp`.
SERVER_IMAGE=ghcr.io/crxnit/bigcapital-server:sha-PINNED
WEBAPP_IMAGE=ghcr.io/crxnit/bigcapital-webapp:sha-PINNED

# ── Public URL (client-branded host; new DNS A-record + Traefik router) ─────
BASE_URL=https://books.sofisminidonuts.com
WEBAPP_BASE_URL=https://books.sofisminidonuts.com

# ── Internal URLs (must reference THIS stack's container_names) ─────────────
GOTENBERG_URL=http://bigcapital-sofis-gotenberg:3000
GOTENBERG_DOCS_URL=http://bigcapital-sofis-server:3000/public/
S3_ENDPOINT=http://bigcapital-sofis-minio:9000

# ── Database (fresh, instance-local) ────────────────────────────────────────
DB_USER=bigcapital
# openssl rand -hex 24
DB_PASSWORD=<fresh-db-password>
# openssl rand -hex 24
DB_ROOT_PASSWORD=<fresh-db-root-password>
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_sofis_system
TENANT_DB_NAME_PERFIX=bigcapital_sofis_tenant_

# ── Auth / signup lockdown (no OAuth edge — Bigcapital JWT is the only gate) ─
# openssl rand -hex 32
JWT_SECRET=<fresh-64-hex-jwt-secret>
# Step 1 (first boot): set SIGNUP_DISABLED=false and put ONLY the client's
# email in SIGNUP_ALLOWED_EMAILS so they (and you) can register the one org.
# Step 2 (after the account exists): set SIGNUP_DISABLED=true and redeploy.
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=<client-login-email>
SIGNUP_EMAIL_CONFIRMATION=false

# ── Object storage (MinIO, instance-local) ──────────────────────────────────
S3_REGION=us-east-1
# openssl rand -hex 16
S3_ACCESS_KEY_ID=<fresh-minio-access-key>
# openssl rand -hex 24
S3_SECRET_ACCESS_KEY=<fresh-minio-secret-key>
S3_BUCKET=bigcapital-sofis-attachments
S3_FORCE_PATH_STYLE=true

# ── Mail (reuse your transactional provider; needed for invites/resets) ─────
MAIL_HOST=<smtp-host>
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-pass>
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM_NAME=Sofi's Mini Donuts Books
MAIL_FROM_ADDRESS=<from-address>

# ── Exchange rates (single-currency USD client — optional) ──────────────────
EXCHANGE_RATE_SERVICE=openexchangerate
# Put the bare app id on its own line (no inline comment — see header note).
OPEN_EXCHANGE_RATE_APP_ID=<openexchangerates-app-id-or-leave-blank>

# ── Rate limiting (defaults of 100/10 are too strict — see CLAUDE.md) ───────
THROTTLE_GLOBAL_LIMIT=600
THROTTLE_GLOBAL_TTL=60000
THROTTLE_AUTH_LIMIT=60
THROTTLE_AUTH_TTL=60000

# ── Bank feeds / Plaid (enable later if the client wants live bank sync) ────
BANK_FEED_ENABLED=false
PLAID_ENV=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_LINK_WEBHOOK=

# ── Billing / cloud flags (self-hosted single tenant — keep off) ────────────
HOSTED_ON_BIGCAPITAL_CLOUD=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Stripe (online invoice payments — optional, leave blank if unused) ──────
STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=

# ── Square (this client uses Square — register a dedicated app for this host) ─
# Redirect URL to register on the Square app:
#   https://books.sofisminidonuts.com/api/integrations/square/oauth/callback
SQUARE_APPLICATION_ID=<square-app-id-or-blank-until-phase-2>
SQUARE_APPLICATION_SECRET=<square-app-secret-or-blank>
SQUARE_APPLICATION_ACCESS_TOKEN=<square-pat-or-blank>
SQUARE_ENVIRONMENT=production
SQUARE_OAUTH_REDIRECT_URL=https://books.sofisminidonuts.com/api/integrations/square/oauth/callback
# Fresh key, distinct from every other instance — openssl rand -hex 32
SQUARE_TOKEN_ENCRYPTION_KEY=<fresh-64-hex-distinct-from-staging-and-sandbox>
